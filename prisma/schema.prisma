// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  date        String   // ISO-8601 DateTime string for SQLite strftime compatibility
  amount      Float
  category    String
  description String?
  type        String   @default("expense") // "expense" or "income"

  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([userId])
  @@index([recurringTransactionId])
}

model RecurringTransaction {
  id          String   @id @default(uuid()) @map("_id")
  userId      String
  amount      Float
  category    String
  description String?
  type        String   @default("expense") // "expense" or "income"
  
  // Recurrence pattern
  frequency   String   // "daily", "weekly", "monthly", "yearly"
  interval    Int      @default(1) // Every X units
  dayOfWeek   Int?     // For weekly: 0-6 (Sunday-Saturday)
  dayOfMonth  Int?     // For monthly: 1-31
  monthOfYear Int?     // For yearly: 0-11 (January-December)
  
  // Lifecycle dates
  startDate   String   // ISO-8601 DateTime string for SQLite strftime compatibility
  nextDue     String   // ISO-8601 DateTime string for SQLite strftime compatibility
  
  // Status
  isActive    Boolean  @default(true)
  
  // Metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Optional: back relation for convenience
  transactions Transaction[]

  @@index([userId])
  @@index([nextDue])
}

model Conversation {
  id        String   @id @default(uuid()) @map("_id")
  userId    String    // WhatsApp JID
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(uuid()) @map("_id")
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // 'user' or 'model'
  content        String       // JSON stringified content
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}
