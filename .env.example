# Gemini AI API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# Server Configuration
PORT=3001

# WhatsApp API Configuration
# The URL where your WhatsApp API is running
# Local development: http://localhost:3000
# Docker: http://host.docker.internal:3000 (to access host services)
WHATSAPP_API_URL="http://localhost:3000"

# WhatsApp Webhook Path (the path where WhatsApp will send incoming messages)
WHATSAPP_WEBHOOK_URL="/whatsapp"

# MongoDB Database
# Local: mongodb://localhost:27017/expense_tracker?replicaSet=rs0
# Docker: mongodb://mongodb:27017/expense_tracker?replicaSet=rs0
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/expense_tracker?replicaSet=rs0
DATABASE_URL="mongodb://localhost:27017/expense_tracker?replicaSet=rs0"

# Gemini Model Configuration
# Available models: gemini-2.0-flash-exp, gemini-2.0-flash-lite-001, gemini-1.5-pro, gemini-1.5-flash, gemma-3-27b-it, etc.
GEMINI_MODEL="gemini-2.0-flash-lite-001"

# Qdrant Vector Database URL
# Local: http://localhost:6333
# Docker: http://qdrant:6333
QDRANT_URL="http://localhost:6333"

# Embedding Similarity Threshold (0.0 to 1.0)
EMBEDDING_THRESHOLD=0.84
